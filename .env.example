# Copy this file to .env and fill in real values. .env is never committed.

# --- OpenAI (generation + embeddings) ---
OPENAI_API_KEY=
GEN_MODEL_ID=           # confirmed by scripts/check_providers.py
FAST_MODEL_ID=          # confirmed by scripts/check_providers.py

# --- Cohere (reranking) ---
COHERE_API_KEY=
RERANK_MODEL_ID=        # TODO(architect): confirm in Cohere docs
RERANK_ENABLED=true

# --- Supabase Postgres (use the pooler connection string) ---
DATABASE_URL=

# --- PubMed / NCBI (they ask for a contact email) ---
NCBI_EMAIL=

# --- App ---
ACCESS_CODES={"example-code": "Display Name"}
USE_MOCK=1
MAX_BRIEFS_PER_DAY=30
MAX_ASKS_PER_DAY=200
